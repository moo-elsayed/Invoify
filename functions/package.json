{
  "name": "invoify-functions",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "build": "tsc && node -e \"const fs = require('fs'); fs.mkdirSync('lib/assets/fonts', { recursive: true }); fs.copyFileSync('src/assets/fonts/Amiri-Regular.ttf', 'lib/assets/fonts/Amiri-Regular.ttf'); fs.copyFileSync('src/assets/fonts/Amiri-Bold.ttf', 'lib/assets/fonts/Amiri-Bold.ttf');\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@firebase/app": "^0.16.0",
    "@fontsource/cairo": "^5.3.0",
    "arabic-persian-reshaper": "^1.0.1",
    "bidi-js": "^1.0.3",
    "dotenv": "^16.4.5",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
